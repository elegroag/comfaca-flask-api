<!-- Sección 2: Datos del Trabajador -->
<div class="section">
    <div class="section-header">2. DATOS DEL TRABAJADOR</div>
    <table>
        <tr>
            <td style="width: 20%;">No. Identificación: {{cedtra}}</td>
            <td style="width: 30%;">
                <div class="d-flex">
                    <table class="table-anidada">
                        <tr>
                            <td>
                                <div class="list-item">
                                    <span {% if tipdoc=='1' %} class="small-checkbox active" {% else %}
                                        class="small-checkbox" {% endif %}>{% if tipdoc=='1' %}X{% endif %}</span>
                                    <span>C.C.</span>
                                </div>
                            </td>
                            <td>
                                <div class="list-item">
                                    <span {% if tipdoc=='2' %} class="small-checkbox active" {% else %}
                                        class="small-checkbox" {% endif %}>{% if tipdoc=='2' %}X{% endif %}</span>
                                    <span>T.I.</span>
                                </div>
                            </td>
                            <td>
                                <div class="list-item">
                                    <span {% if tipdoc=='4' %} class="small-checkbox active" {% else %}
                                        class="small-checkbox" {% endif %}>{% if tipdoc=='4' %}X{% endif %}</span>
                                    <span>C.E.</span>
                                </div>
                            </td>
                            <td>
                                <div class="list-item">
                                    <span {% if tipdoc=='13' %} class="small-checkbox active" {% else %}
                                        class="small-checkbox" {% endif %}>{% if tipdoc=='13' %}X{% endif %}</span>
                                    <span>VISA</span>
                                </div>
                            </td>
                            <td>
                                <div class="list-item">
                                    <span {% if tipdoc=='6' %} class="small-checkbox active" {% else %}
                                        class="small-checkbox" {% endif %}>{% if tipdoc=='6' %}X{% endif %}</span>
                                    <span>PAS.</span>
                                </div>
                            </td>
                            <td>
                                <div class="list-item">
                                    <span {% if tipdoc=='8' %} class="small-checkbox active" {% else %}
                                        class="small-checkbox" {% endif %}>{% if tipdoc=='8' %}X{% endif %}</span>
                                    <span>P.E.P.</span>
                                </div>
                            </td>
                            <td>
                                <div class="list-item">
                                    <span {% if tipdoc=='11' %} class="small-checkbox active" {% else %}
                                        class="small-checkbox" {% endif %}>{% if tipdoc=='11' %}X{% endif %}</span>
                                    <span>C.D.</span>
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
            </td>
            <td style="width: 40%;">Correo Electrónico: {{email}}</td>
            <td style="width: 10%;">Celular: {{celular}}</td>
        </tr>
    </table>
    <table>
        <thead>
            <tr>
                <td class="label border-t">Primer Apellido</td>
                <td class="label border-t">Segundo Apellido</td>
                <td class="label border-t">Primer Nombre</td>
                <td class="label border-t">Segundo Nombre</td>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    <div class="text">{{priape}}</div>
                </td>
                <td>
                    <div class="text">{{segape}}</div>
                </td>
                <td>
                    <div class="text">{{prinom}}</div>
                </td>
                <td>
                    <div class="text">{{segnom}}</div>
                </td>
            </tr>
        </tbody>
    </table>
    <table>
        <thead>
            <tr>
                <th class="label border-t">Fecha de Nacimiento</th>
                <th class="label border-t">Sexo</th>
                <th class="label border-t">Estado Civil</th>
                <th class="label border-t">ZONA RESIDENCIA</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td style="width: 10%">
                    <table class="table-anidada">
                        <tr>
                            <td>
                                <div class="text"><small>{{fecnac_year}}</small></div>
                            </td>
                            <td>
                                <div class="text"><small>{{fecnac_month}}</small></div>
                            </td>
                            <td>
                                <div class="text"><small>{{fecnac_day}}</small></div>
                            </td>
                        </tr>
                    </table>
                </td>
                <td style="width: 20%;">
                    <table class="table-anidada">
                        <tr>
                            <td>
                                <div class="inline-checkbox"><label>F</label> <span {% if sexo=='F' %}
                                        class="small-checkbox active" {% else %} class="small-checkbox" {% endif
                                        %}>{% if sexo=='F' %}X{% endif %}</span> </div>
                            </td>
                            <td>
                                <div class="inline-checkbox"><label>M</label> <span {% if sexo=='M' %}
                                        class="small-checkbox active" {% else %} class="small-checkbox" {% endif
                                        %}>{% if sexo=='M' %}X{% endif %}</span> </div>
                            </td>
                            <td>
                                <div class="inline-checkbox"><label>I</label> <span {% if sexo=='I' %}
                                        class="small-checkbox active" {% else %} class="small-checkbox" {% endif
                                        %}>{% if sexo=='I' %}X{% endif %}</span> </div>
                            </td>
                        </tr>
                    </table>
                </td>
                <td style="width: 40%">
                    <table class="table-anidada">
                        <tr>
                            <td>
                                <div class="inline-checkbox"><label>UL</label> <span {% if estciv=='4' %}
                                        class="small-checkbox active" {% else %} class="small-checkbox" {% endif
                                        %}>{% if estciv=='4' %}X{% endif %}</span> </div>
                            </td>
                            <td>
                                <div class="inline-checkbox"><label>CAS</label> <span {% if estciv=='2' %}
                                        class="small-checkbox active" {% else %} class="small-checkbox" {% endif
                                        %}>{% if estciv=='CAS' %}X{% endif %}</span> </div>
                            </td>
                            <td>
                                <div class="inline-checkbox"><label>DIV</label> <span {% if estciv=='6' %}
                                        class="small-checkbox active" {% else %} class="small-checkbox" {% endif
                                        %}>{% if estciv=='6' %}X{% endif %}</span> </div>
                            </td>
                            <td>
                                <div class="inline-checkbox"><label>SEP</label> <span {% if estciv=='5' %}
                                        class="small-checkbox active" {% else %} class="small-checkbox" {% endif
                                        %}>{% if estciv=='5' %}X{% endif %}</span> </div>
                            </td>
                            <td>
                                <div class="inline-checkbox"><label>VIU</label> <span {% if estciv=='3' %}
                                        class="small-checkbox active" {% else %} class="small-checkbox" {% endif
                                        %}>{% if estciv=='3' %}X{% endif %}</span> </div>
                            </td>
                            <td>
                                <div class="inline-checkbox"><label>SOL</label> <span {% if estciv=='1' %}
                                        class="small-checkbox active" {% else %} class="small-checkbox" {% endif
                                        %}>{% if estciv=='1' %}X{% endif %}</span> </div>
                            </td>
                        </tr>
                    </table>
                </td>
                <td style="width: 20%">
                    <table class="table-anidada">
                        <tr>
                            <td>
                                <div class="inline-checkbox"><label>U</label> <span {% if rural=='N' %}
                                        class="small-checkbox active" {% else %} class="small-checkbox" {% endif
                                        %}>{% if rural=='N' %}X{% endif %}</span> </div>
                            </td>
                            <td>
                                <div class="inline-checkbox"><label>R</label> <span {% if rural=='S' %}
                                        class="small-checkbox active" {% else %} class="small-checkbox" {% endif
                                        %}>{% if rural=='S' %}X{% endif %}</span> </div>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
    <table>
        <tbody>
            <tr>
                <td class="label border-t">Dirección de residencia del trabajador</td>
                <td class="label border-t">Barrio</td>
                <td class="label border-t">Ciudad</td>
            </tr>
            <tr>
                <td>{{direccion}}</td>
                <td>{{barrio}}</td>
                <td>{{codciu}}</td>
            </tr>
        </tbody>
    </table>
    <table>
        <tbody>
            <tr>
                <td class="label border-t">Resguardo</td>
                <td class="border-t" style="height: 20px;">{{resguardo_name}}</td>
                <td class="label border-t">Pueblo Indígena</td>
                <td class="border-t">{{pueblo_name}}</td>
            </tr>
        </tbody>
    </table>
</div>