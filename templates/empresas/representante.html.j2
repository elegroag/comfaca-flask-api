<!-- Section 3: Datos del Representante Legal -->
<div class="section-header" style="margin-bottom: 0px">
  3. DATOS DEL REPRESENTANTE LEGAL
</div>
<table>
  <tr>
    <td class="label-bg" style="width: 15%">
      <label class="form-label">Número de Identificación</label>
    </td>
    <td style="width: 20%">
      <span class="text">{{cedrep}}</span>
    </td>
    <td class="label-bg" style="width: 20%">
      <label class="form-label">Tipo de Identificación:</label>
    </td>
    <td style="width: 60%">
      <div class="d-flex">
        <table class="table-anidada">
          <tr>
            <td>
              <div class="list-item">
                <span class="small-checkbox{{ ' active' if coddocrepleg=='NI' else '' }}">{% if coddocrepleg=='NI' %}x{% endif %}</span>
                <span>NIT</span>
              </div>
            </td>
            <td>
              <div class="list-item">
                <span class="small-checkbox{{ ' active' if coddocrepleg=='CC' else '' }}">{% if coddocrepleg=='CC' %}x{% endif %}</span>
                <span>C.C.</span>
              </div>
            </td>
            <td>
              <div class="list-item">
                <span class="small-checkbox{{ ' active' if coddocrepleg=='TI' else '' }}">{% if coddocrepleg=='TI' %}x{% endif %}</span>
                <span>T.I.</span>
              </div>
            </td>
            <td>
              <div class="list-item">
                <span class="small-checkbox{{ ' active' if coddocrepleg=='CE' else '' }}">{% if coddocrepleg=='CE' %}x{% endif %}</span>
                <span>C.E.</span>
              </div>
            </td>
            <td>
              <div class="list-item">
                <span class="small-checkbox{{ ' active' if coddocrepleg=='V' else '' }}">{% if coddocrepleg=='V' %}x{% endif %}</span>
                <span>VISA</span>
              </div>
            </td>
            <td>
              <div class="list-item">
                <span class="small-checkbox{{ ' active' if coddocrepleg=='PA' else '' }}">{% if coddocrepleg=='PA' %}x{% endif %}</span>
                <span>PAS.</span>
              </div>
            </td>
            <td>
              <div class="list-item">
                <span class="small-checkbox{{ ' active' if coddocrepleg=='PEP' else '' }}">{% if coddocrepleg=='PEP' %}x{% endif %}</span>
                <span>P.E.P.</span>
              </div>
            </td>
            <td>
              <div class="list-item">
                <span class="small-checkbox{{ ' active' if coddocrepleg=='CD' else '' }}">{% if coddocrepleg=='CD' %}x{% endif %}</span>
                <span>C.D.</span>
              </div>
            </td>
            <td>
              <div class="list-item">
                <span class="small-checkbox{{ ' active' if coddocrepleg=='CB' else '' }}">{% if coddocrepleg=='CB' %}x{% endif %}</span>
                <span>C.B.</span>
              </div>
            </td>
          </tr>
        </table>
      </div>
    </td>
  </tr>
  <tr>
    <td class="label-bg">
      <div class="form-label">Apellidos y Nombres</div>
    </td>
    <td>
      <div>{{repleg}}</div>
    </td>
    <td class="label-bg">
      <div class="form-label">Teléfono Fijo</div>
    </td>
    <td>
      <div>{{telpri}}</div>
    </td>
  </tr>
  <tr>
    <td class="label-bg">
      <div class="form-label">Celular</div>
    </td>
    <td>
      <div>{{celpri}}</div>
    </td>
    <td class="label-bg">
      <div class="form-label">Correo electrónico</div>
    </td>
    <td>
      <div>{{emailpri}}</div>
    </td>
  </tr>

</table>