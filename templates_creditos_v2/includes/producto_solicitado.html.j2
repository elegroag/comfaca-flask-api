{% from "macros/macros.html.j2" import check %}
{# Sección 2: Producto solicitado
   Opciones: A=Educación, B=Salud, C=Vivienda, D=Libre Inversión, E=Recreación y Turismo
   Cualquier otro valor no vacío marca "Otros".
#}
{% set producto = (solicitud.producto_tipo or '')|string|trim|upper %}
<div class="section s2">
  <div class="section-title">PRODUCTO SOLICITADO (Marque con una X)</div>
  <table class="section-frame">
    <tr>
      <td class="sec-num">2</td>
      <td class="sec-main s2-products-cell">
        <div class="s2-products">
          <div class="check-item">
            {{ check(producto == 'A', 'lg') }} A. Educación
          </div>
          <div class="check-item">
            {{ check(producto == 'B', 'lg') }} B. Salud
          </div>
          <div class="check-item">
            {{ check(producto == 'C', 'lg') }} C. Vivienda
          </div>
          <div class="check-item">
            {{ check(producto == 'D', 'lg') }} D. Libre Inversión
          </div>
          <div class="check-item">
            {{ check(producto == 'E', 'lg') }} E. Recreación y Turismo
          </div>
          <div class="check-item">
            {{ check(producto and producto not in ['A', 'B', 'C', 'D', 'E'], 'lg') }} Otros
          </div>
        </div>
      </td>
      <td class="s2-credito-cell">
        <div class="s2-credito">
          <span>Ha tenido crédito con Comfaca:</span>
          <div class="check-item">{{ check(solicitud.ha_tenido_credito_comfaca, 'lg') }} SI</div>
          <div class="check-item">{{ check(not solicitud.ha_tenido_credito_comfaca, 'lg') }} NO</div>
        </div>
      </td>
    </tr>
  </table>
</div>
