{# Referencias del solicitante #}
<table>
  <colgroup>
    <col style="width: 60%;">
    <col style="width: 40%;">
  </colgroup>
  <tr>
    <td colspan="3" class="section-header">REFERENCIAS</td>
  </tr>

  <tr>
    <td colspan="3" class="bg-light-green font-bold">FAMILIAR</td>
  </tr>
  {% if referencias and referencias|length > 0 %}
  {% for referencia in referencias %}
  {% if referencia.tipo == 'familiar' %}
  <tr>
    <td>
      <span class="field-label">Nombre / Apellidos</span><br>
      <div class="input-min-field">{{ referencia.nombre_apellidos|default('') }}</div>
    </td>
    <td colspan="2">
      <span class="field-label">No. Celular</span><br>
      <div class="input-min-field">{{ referencia.celular|default('') }}</div>
    </td>
  </tr>
  {% endif %}
  {% endfor %}
  {% endif %}

  <tr>
    <td colspan="3" class="bg-light-green font-bold">PERSONAL (Que no viva con usted)</td>
  </tr>
  {% if referencias and referencias|length > 0 %}
  {% for referencia in referencias %}
  {% if referencia.tipo == 'personal' %}
  <tr>
    <td>
      <span class="field-label">Nombre / Apellidos</span><br>
      <div class="input-min-field">{{ referencia.nombre_apellidos|default('') }}</div>
    </td>
    <td colspan="2">
      <span class="field-label">No. Celular</span><br>
      <div class="input-min-field">{{ referencia.celular|default('') }}</div>
    </td>
  </tr>
  {% endif %}
  {% endfor %}
  {% endif %}
</table>